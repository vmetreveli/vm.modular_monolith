# Copy to .env and fill in values. .env is gitignored — never commit secrets.

# --- PostgreSQL (used by ModularMonolithDb container) ---
POSTGRES_DB=ModularMonolithDb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# --- GitHub Packages NuGet feed (needed by `docker compose build`) ---
# PAT with read:packages scope; can also be exported in the shell instead.
GITHUB_TOKEN=
