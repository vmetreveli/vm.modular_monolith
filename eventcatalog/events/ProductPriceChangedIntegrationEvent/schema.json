      "type": "string",
      "description": "Product name"
    },
    "Category": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Product categories"
    },
    "Description": {
      "type": "string",
      "description": "Product description"
    },
    "ImageFile": {
      "type": "string",
      "description": "Product image file path"
    },
    "Price": {
      "type": "number",
