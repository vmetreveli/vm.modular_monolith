# --- PostgreSQL ---
POSTGRES_DB=ModularMonolithDb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Connection string (Docker network) ---
ConnectionStrings__DefaultConnection=Server=modularmonolithdb;Port=5432;Database=ModularMonolithDb;User Id=postgres;Password=postgres;

# --- ASP.NET ---
AllowedHosts=*

# --- RabbitMQ ---
AppConfiguration__RabbitMQ__ExchangeName=rabbitmq
AppConfiguration__RabbitMQ__Host=rabbitmq
AppConfiguration__RabbitMQ__VirtualHost=/
AppConfiguration__RabbitMQ__Username=modular
AppConfiguration__RabbitMQ__Password=modular

# --- Quartz ---
AppConfiguration__Quartz__OutboxJob=0/3 * * * * ?

