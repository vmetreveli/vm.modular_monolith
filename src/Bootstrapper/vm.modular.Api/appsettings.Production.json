{
  // Secrets are supplied via environment variables in production:
  //   ConnectionStrings__DefaultConnection
  //   AppConfiguration__RabbitMQ__Host / __Username / __Password
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
      //      "Serilog.Sinks.Elasticsearch"
    ],
    "MinimumLevel": "Debug",
    "Enrich": [
      "WithMachineName",
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "AllowedHosts": "*",
  "AppConfiguration": {
    "RabbitMQ": {
      "ExchangeName": "Name",
      "Host": "",
      "Port": 5672,
      "VirtualHost": "/",
      "Username": "",
      "Password": ""
    },
    "Quartz": {
      "OutboxJob": "0/3 * * * * ?"
    },
    "ExternalServices": {
      "CatalogApi": {
        "BaseAddress": "http://localhost:8080/api/v1/"
      }
    }
  }
}
